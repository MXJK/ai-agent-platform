APP_NAME=ai-agent-platform
API_PREFIX=/api/v1

# Local structured store. PostgreSQL is intended to become the source of truth
# for sessions, messages, agent runs, checkpoints, and document metadata.
DATABASE_URL=postgresql://ai_agent:ai_agent_password@localhost:5432/ai_agent_platform
SESSION_REPOSITORY=memory
AGENT_RUN_STORE=memory
DOCUMENT_STORE=memory
REPOSITORY_INDEX_STORE=memory
LANGGRAPH_CHECKPOINTER=memory

# LLM and embedding defaults for local development.
LLM_PROVIDER=fake
LLM_MODEL=demo-stream-model
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001

# Optional real provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Vector store. Switch to qdrant after installing dependencies and starting Qdrant.
RAG_VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=repo_chunks

# Existing Chroma fallback.
CHROMA_PERSIST_DIRECTORY=.chroma
CHROMA_COLLECTION_NAME=rag_chunks

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RECALL_LIMIT=20
RAG_RERANKER_PROVIDER=none
RAG_MAX_PROMPT_CHARS=6000

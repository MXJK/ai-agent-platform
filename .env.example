APP_NAME=ai-agent-platform
API_PREFIX=/api/v1
APP_PORT=8001
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional JSON layer locations. When unset, the resolver checks the conventional
# user and project paths documented in README.md.
# AI_AGENT_PLATFORM_USER_CONFIG=/path/to/user-config.json
# Explicit process-controlled project input; Workspace auto-discovery is Run-scoped.
# AI_AGENT_PLATFORM_PROJECT_CONFIG=/path/to/project-config.json

# Optional Go traffic gateway. Rate limiting is disabled when requests per
# second is 0; concurrency admission remains enabled to protect each replica.
GATEWAY_LISTEN_ADDRESS=:8080
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8001
GATEWAY_MAX_BODY_BYTES=2097152
GATEWAY_MAX_CONCURRENT_REQUESTS=256
GATEWAY_REQUESTS_PER_SECOND=0
GATEWAY_RATE_LIMIT_BURST=100
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_IDLE_TIMEOUT=2m
GATEWAY_UPSTREAM_DIAL_TIMEOUT=5s
GATEWAY_UPSTREAM_HEADER_TIMEOUT=30s
GATEWAY_READINESS_TIMEOUT=2s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info
GATEWAY_AUTH_MODE=disabled
GATEWAY_OIDC_ISSUER=
GATEWAY_OIDC_AUDIENCE=
GATEWAY_OIDC_JWKS_URL=
GATEWAY_OIDC_JWKS_CACHE_TTL=5m

# Persistent structured store. PostgreSQL is the source of truth for sessions,
# messages, agent runs, checkpoints, workspaces, and document/chunk metadata.
# Copy this file to .env, generate a local-only password, and use the same value
# in POSTGRES_PASSWORD and DATABASE_URL. These variables are required by Compose.
POSTGRES_DB=ai_agent_platform
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://ai_agent:replace-with-a-random-local-password@localhost:5432/ai_agent_platform
SESSION_REPOSITORY=postgres
AGENT_RUN_STORE=postgres
CHANGE_SET_STORE=postgres
DOCUMENT_STORE=postgres
WORKSPACE_STORE=postgres
# Colon-separated on macOS/Linux. Blank defaults to the current user's home
# directory for local folder selection. Set explicit minimal roots in deployments.
WORKSPACE_ALLOWED_ROOTS=
LANGGRAPH_CHECKPOINTER=postgres

# LLM and embedding defaults for local development.
LLM_PROVIDER=fake
LLM_MODEL=demo-stream-model
LLM_MAX_OUTPUT_TOKENS=4096
# Without a catalog, the router derives one conservative entry from the two
# values above. Set a one-line JSON array to enable real multi-model routing;
# each entry declares provider, model, capabilities, context window, prices,
# quality_score, latency_ms, and enabled.
LLM_MODEL_CATALOG_JSON=
LLM_MODEL_CONTEXT_WINDOW_TOKENS=128000
LLM_ROUTING_POLICY=smart
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
LLM_CIRCUIT_ERROR_WINDOW_SIZE=20
LLM_CIRCUIT_ERROR_RATE_MIN_REQUESTS=5
LLM_CIRCUIT_ERROR_RATE_THRESHOLD=0.5
# The registry follows SESSION_REPOSITORY when omitted. API keys written by the
# frontend are stored in the operating-system keyring and never in PostgreSQL.
# Enabled provider connections and registered models are the runtime admission
# source; frontend model choices require no static environment allowlist.
MODEL_REGISTRY_STORE=postgres
MODEL_SECRET_BACKEND=keyring
# 0 disables the scope. Reject clamps max output to the remaining hard budget;
# downgrade requires the fallback pair and records both requested/actual model.
SESSION_TOKEN_BUDGET=0
WORKSPACE_TOKEN_BUDGET=0
TOKEN_BUDGET_ACTION=reject
TOKEN_BUDGET_FALLBACK_PROVIDER=
TOKEN_BUDGET_FALLBACK_MODEL=
# Gemini 3 supports minimal, low, medium, and high. The frontend can override
# this per request; non-Gemini-3 models ignore the server default.
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
SSE_HEARTBEAT_SECONDS=10
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=6
CONVERSATION_SUMMARY_MAX_CHARS=2000
CONVERSATION_SUMMARY_MAX_SOURCE_CHARS=12000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001

# Optional real provider keys.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Persistent RAG vector store. Qdrant stores embeddings and retrieval payloads;
# PostgreSQL above stores document/chunk metadata.
RAG_VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks

# Workspace-scoped long-term project memory. Keep off until the schema is
# migrated and a workspace has explicitly selected shadow/review/auto mode.
PROJECT_MEMORY_ENABLED=false
PROJECT_MEMORY_MODE=off
PROJECT_MEMORY_CANDIDATE_THRESHOLD=0.60
PROJECT_MEMORY_AUTO_THRESHOLD=0.85
PROJECT_MEMORY_RECALL_LIMIT=20
PROJECT_MEMORY_RESULT_LIMIT=6
PROJECT_MEMORY_MAX_CONTEXT_CHARS=3000
PROJECT_MEMORY_QDRANT_COLLECTION=project_memories
PROJECT_MEMORY_RELEVANCE_WEIGHT=0.65
PROJECT_MEMORY_RECENCY_WEIGHT=0.20
PROJECT_MEMORY_IMPORTANCE_WEIGHT=0.15
PROJECT_MEMORY_RECENCY_HALF_LIFE_DAYS=180

# Safe baseline. To enable the local direct-write profile, use trusted_header,
# set a random shared secret on both processes, choose GATEWAY_AUTH_MODE=local,
# and keep the compose gateway port published to 127.0.0.1 only.
AUTH_MODE=disabled
LIVE_WORKSPACE_WRITES_ENABLED=false
CHANGE_SET_APPLY_MODE=patch_only
CHANGE_SET_MAX_FILES=100
CHANGE_SET_MAX_PATCH_CHARS=1000000
CHANGE_SET_WORKTREE_PARENT=
CHANGE_SET_BRANCH_PREFIX=codex/
GATEWAY_TRUST_SECRET=
GATEWAY_LOCAL_USER_ID=demo_user

# Optional single-process alternative to Qdrant. Set RAG_VECTOR_STORE=chroma
# explicitly to use it; the application does not dual-write both stores.
CHROMA_PERSIST_DIRECTORY=.chroma
CHROMA_COLLECTION_NAME=rag_chunks

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RECALL_LIMIT=20
RAG_LEXICAL_WEIGHT=0.35
RAG_RRF_K=60
RAG_RERANKER_PROVIDER=sentence_transformer
SENTENCE_TRANSFORMER_RERANKER_MODEL=BAAI/bge-reranker-base
SENTENCE_TRANSFORMER_RERANKER_DEVICE=cpu
RAG_RERANK_DEFAULT_ENABLED=false
RAG_MAX_PROMPT_CHARS=6000
BACKGROUND_TASK_WORKERS=4
BACKGROUND_TASK_QUEUE_CAPACITY=100
# Redis-backed Celery queue. API and workers must use the same PostgreSQL,
# Qdrant, Redis, workspace mounts, and allowed roots.
TASK_QUEUE_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=2
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=60
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=960
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# Agent execution sandbox. Use local for tests/development, docker for stronger
# isolation when Docker is available.
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_COMMAND_OUTPUT_MAX_CHARS=12000
SANDBOX_WORKSPACE_PARENT=
SANDBOX_WORKSPACE_TTL_SECONDS=86400
SANDBOX_ALLOWED_COMMANDS=alembic,cargo,git,go,mypy,node,npm,npx,poetry,pytest,python,python3,ruff,rustc,tox,uv

# Task-driven source exploration budgets.
AGENT_MAX_EXPLORATION_ROUNDS=4
AGENT_MAX_READ_TOOLS_PER_ROUND=6
AGENT_MAX_CONTEXT_FILES=12
AGENT_MAX_CONTEXT_CHARS=32000
AGENT_MAX_INSTRUCTION_CHARS=16000
AGENT_SOFT_TOOL_ROUNDS=12
AGENT_MAX_TOOL_ROUNDS=24
AGENT_SOFT_TOOL_CALLS=36
AGENT_MAX_TOOL_CALLS=72
AGENT_MAX_ELAPSED_SECONDS=900
AGENT_NO_PROGRESS_ROUNDS=3
AGENT_MAX_CONSECUTIVE_FAILURES=3
AGENT_NATIVE_CONTEXT_MAX_CHARS=48000
AGENT_NATIVE_CONTEXT_KEEP_MESSAGES=10
AGENT_GRAPH_RECURSION_LIMIT=128
# always: approve every tool; on_request: approve side effects; never: block them.
AGENT_APPROVAL_POLICY=on_request

# Optional MCP tool servers. Disabled by default so local startup does not
# require external MCP binaries.
MCP_ALLOWED=true
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp.json
MCP_REQUEST_TIMEOUT_SECONDS=10
SKILLS_ALLOWED=true
SKILLS_ENABLED=false

# Default profile: personal, single-process, no PostgreSQL/Qdrant/Redis required.
# Copy this file to .env. RUNTIME_PROFILE expands the locked backend combination;
# use custom only when intentionally testing a manual mix of stores.
RUNTIME_PROFILE=local

# Application and local state
APP_NAME=ai-agent-platform
API_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=1
LOG_LEVEL=INFO
LOG_FORMAT=json
LOCAL_STATE_PATH=~/.ai-agent-platform/state.sqlite3
WORKSPACE_ALLOWED_ROOTS=

# The local profile automatically selects:
# - SQLite: Session, Agent Run, Workspace, L1/L3 memory and memory vectors.
# - process memory: ChangeSet, documents, model registry, LangGraph checkpoint,
#   and document RAG vectors.
# - in_process: background tasks.
# TODO(local-persistence): add SQLite adapters for the process-memory stores above
# before describing every local feature as restart-persistent.

# LLM and embedding
LLM_PROVIDER=fake
LLM_MODEL=demo-stream-model
LLM_MAX_OUTPUT_TOKENS=4096
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
RAG_RERANKER_PROVIDER=none
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_SECRET_BACKEND=keyring

# Local memory governance; these are also the local profile defaults.
PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_MODE=review
USER_MEMORY_ENABLED=true
USER_MEMORY_MODE=review
USER_PROFILE_MAX_CONTEXT_CHARS=1500
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=6
CONVERSATION_SUMMARY_MAX_CHARS=2000
CONVERSATION_SUMMARY_MAX_SOURCE_CHARS=12000

# Safe workspace-write baseline. To enable direct/worktree writes locally, switch
# AUTH_MODE to trusted_header, generate one random GATEWAY_TRUST_SECRET, set
# GATEWAY_AUTH_MODE=local, then explicitly enable the allowed modes.
AUTH_MODE=disabled
GATEWAY_AUTH_MODE=disabled
GATEWAY_TRUST_SECRET=
GATEWAY_LOCAL_USER_ID=demo_user
LIVE_WORKSPACE_WRITES_ENABLED=false
AGENT_WORKSPACE_DEFAULT_MODE=patch_only
AGENT_WORKSPACE_ALLOWED_MODES=patch_only
CHANGE_SET_APPLY_MODE=patch_only
CHANGE_SET_MAX_FILES=100
CHANGE_SET_MAX_PATCH_CHARS=1000000
CHANGE_SET_WORKTREE_PARENT=
CHANGE_SET_BRANCH_PREFIX=codex/

# Optional loopback Go gateway. start-local.sh starts only this container when
# GATEWAY_AUTH_MODE is local; it never starts the production data services.
GATEWAY_LISTEN_ADDRESS=:8080
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8001
GATEWAY_MAX_BODY_BYTES=2097152
GATEWAY_MAX_CONCURRENT_REQUESTS=256
GATEWAY_REQUESTS_PER_SECOND=0
GATEWAY_RATE_LIMIT_BURST=100
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_IDLE_TIMEOUT=2m
GATEWAY_UPSTREAM_DIAL_TIMEOUT=5s
GATEWAY_UPSTREAM_HEADER_TIMEOUT=30s
GATEWAY_READINESS_TIMEOUT=2s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info

# Local process limits and integrations
BACKGROUND_TASK_WORKERS=4
BACKGROUND_TASK_QUEUE_CAPACITY=100
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_COMMAND_OUTPUT_MAX_CHARS=12000
SANDBOX_WORKSPACE_PARENT=
SANDBOX_WORKSPACE_TTL_SECONDS=86400
SANDBOX_ALLOWED_COMMANDS=alembic,cargo,git,go,mypy,node,npm,npx,poetry,pytest,python,python3,ruff,rustc,tox,uv
AGENT_APPROVAL_POLICY=on_request
MCP_ALLOWED=true
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp.json
MCP_REQUEST_TIMEOUT_SECONDS=10
SKILLS_ALLOWED=true
SKILLS_ENABLED=false

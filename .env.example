# Single-user, single-instance Docker Compose self-hosting.
# Copy this file to .env, select an LLM provider, then run:
#   docker compose up -d --build

# Compose-owned product boundary. The service container overrides infrastructure
# values with the same contract so accidental local/production profile mixing fails
# closed. These values also make ConfigResolver tests and direct diagnostics explicit.
RUNTIME_PROFILE=custom
APP_NAME=ai-agent-platform
API_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000
SELF_HOSTED_PORT=8000
APP_RELOAD=0
LOG_LEVEL=INFO
LOG_FORMAT=json

# Private Compose data plane. PostgreSQL and Qdrant are not published on host ports.
POSTGRES_DB=ai_agent_platform
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://ai_agent:local-only-change-me@postgres:5432/ai_agent_platform
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks
PROJECT_MEMORY_QDRANT_COLLECTION=project_memories

# Reuse the existing persistent repositories with a single in-process task queue.
SESSION_REPOSITORY=postgres
AGENT_RUN_STORE=postgres
CHANGE_SET_STORE=postgres
# Where trajectory eval runs and per-provider baselines are stored.
EVAL_STORE=postgres
# Lets the eval arm a deterministic tool failure so the failure-recovery metric
# can be measured. Scoped to the eval's own workspace; off means the metric
# reports n/a instead of a misleading 1.0.
EVAL_FAULT_INJECTION_ENABLED=false
DOCUMENT_STORE=postgres
WORKSPACE_STORE=postgres
LANGGRAPH_CHECKPOINTER=postgres
MODEL_REGISTRY_STORE=postgres
RAG_VECTOR_STORE=qdrant
PROJECT_MEMORY_STORE=postgres
PROJECT_MEMORY_VECTOR_STORE=qdrant
TASK_QUEUE_BACKEND=in_process
BACKGROUND_TASK_WORKERS=4
BACKGROUND_TASK_QUEUE_CAPACITY=100

# Project memory is part of the MVP. User memory stays off because its current
# implementation is SQLite/process-local and is not needed for the first product cut.
PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_MODE=auto
USER_MEMORY_ENABLED=true
USER_MEMORY_MODE=auto
USER_PROFILE_MAX_CONTEXT_CHARS=1500
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=6
CONVERSATION_SUMMARY_MAX_CHARS=4000
CONVERSATION_SUMMARY_MAX_SOURCE_CHARS=12000
CONVERSATION_SUMMARY_SYNC_ON_OVERFLOW=true

# Context assembly is bounded by both a message count and a token budget derived
# from the context window of the model serving the turn. Set the ceiling equal to
# LLM_MAX_CONTEXT_MESSAGES to keep the previous fixed-length window.
LLM_MAX_CONTEXT_MESSAGES=12
LLM_MAX_CONTEXT_MESSAGES_CEILING=48
LLM_CONTEXT_INPUT_TOKEN_RATIO=0.6
# The resolved input allowance first pays system/tool-schema overhead, then
# divides the remainder between evidence, history, and the tool transcript.
# These two ratios must add to less than 1; the transcript gets the remainder.
LLM_CONTEXT_EVIDENCE_RATIO=0.25
LLM_CONTEXT_HISTORY_RATIO=0.15
AGENT_TOOL_RESULT_KEEP_RECENT=6
AGENT_NATIVE_MAX_COMPACTIONS=3

# LLM generation policy and embeddings. Register Providers and models, including
# all API Keys, only through the model-management UI.
LLM_MAX_OUTPUT_TOKENS=4096
AGENT_PLAN_MAX_OUTPUT_TOKENS=4096
AGENT_MUTATION_MAX_OUTPUT_TOKENS=16384
AGENT_FINAL_MAX_OUTPUT_TOKENS=4096
# Bounds every built-in and MCP result before it enters the transcript (minimum 64).
AGENT_TOOL_RESULT_MAX_TOKENS=2000
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing
RAG_RERANKER_PROVIDER=none
MODEL_SECRET_BACKEND=encrypted_file

# One fixed owner, no gateway and no caller-controlled identity. This mode is safe
# only with the Compose port published to host 127.0.0.1, as defined in compose.
AUTH_MODE=single_user
SINGLE_USER_ID=owner
NATIVE_DIRECTORY_PICKER_MODE=disabled

# Mount one trusted host directory at /workspaces. The existing web directory browser
# selects projects below this root; containers cannot open the host Finder dialog.
WORKSPACE_HOST_PATH=./workspaces
WORKSPACE_ALLOWED_ROOTS=/workspaces
LOCAL_STATE_PATH=/var/lib/ai-agent-platform/state.sqlite3

# Code Agent writes directly to the registered source root after exact tool approval.
# Commands run inside the App container and only trusted personal repositories are
# supported in this loopback-only single-user release.
LIVE_WORKSPACE_WRITES_ENABLED=true
AGENT_WORKSPACE_DEFAULT_MODE=direct
AGENT_WORKSPACE_ALLOWED_MODES=direct
CHANGE_SET_APPLY_MODE=patch_only
CHANGE_SET_MAX_FILES=100
CHANGE_SET_MAX_PATCH_CHARS=1000000
CHANGE_SET_WORKTREE_PARENT=/var/lib/ai-agent-platform/worktrees
CHANGE_SET_BRANCH_PREFIX=codex/
SANDBOX_MODE=local
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_COMMAND_OUTPUT_MAX_CHARS=12000
SANDBOX_WORKSPACE_PARENT=/var/lib/ai-agent-platform/sandboxes
SANDBOX_WORKSPACE_TTL_SECONDS=86400
SANDBOX_ALLOWED_COMMANDS=alembic,cargo,git,go,mypy,node,npm,npx,poetry,pytest,python,python3,ruff,rustc,tox,uv
AGENT_APPROVAL_POLICY=on_request

# Optional integrations remain available but disabled by default. Stdio MCP servers
# run inside the App container; remote MCP servers can be enabled through mcp.json.
MCP_ALLOWED=true
MCP_ENABLED=false
MCP_CONFIG_PATH=~/.ai-agent-platform/mcp.json
SKILLS_DIRECTORY_PATH=~/.ai-agent-platform/skills
MCP_REQUEST_TIMEOUT_SECONDS=10
SKILLS_ALLOWED=true
SKILLS_ENABLED=false

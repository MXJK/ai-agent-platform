# RETAINED COMPATIBILITY PROFILE: not the current product path.
# Backward-compatible focused example. The canonical self-hosted template is
# .env.example; RUNTIME_PROFILE expands and locks the complete backend set.
RUNTIME_PROFILE=local

# Single-process local profile: one SQLite file, no external memory service.
LOCAL_STATE_PATH=~/.ai-agent-platform/state.sqlite3
# Profile-owned backends are intentionally omitted. Explicit conflicting values
# fail at startup; use RUNTIME_PROFILE=custom for an intentional test combination.

PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_MODE=auto
USER_MEMORY_ENABLED=true
USER_MEMORY_MODE=auto
USER_PROFILE_MAX_CONTEXT_CHARS=1500

EMBEDDING_PROVIDER=local
RAG_RERANKER_PROVIDER=none

# RETAINED EXTENSION: this file is not consumed by the current single-node product.
# TODO(PRODUCTION): This profile documents a possible future shared deployment. Do not
# copy it into the current personal environment or run migrations until every
# item below has an owner, an environment-specific value and a rollback plan.
RUNTIME_PROFILE=production

# TODO(PRODUCTION): choose the public topology, TLS termination, domain names,
# readiness/liveness probes, log shipping, metrics and alerting.
APP_NAME=ai-agent-platform
API_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=0
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL is the relational source of truth for API and Celery workers.
# TODO(PRODUCTION): provision managed PostgreSQL, generate credentials in a secret
# manager, enable encrypted connections, backups/PITR and rehearse restore.
POSTGRES_DB=ai_agent_platform
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=replace-from-secret-manager
DATABASE_URL=postgresql://ai_agent:replace-from-secret-manager@localhost:5432/ai_agent_platform

# TODO(PRODUCTION): mount the same workspace paths into every API/Worker and
# restrict this allowlist to the smallest deployment-owned roots.
WORKSPACE_ALLOWED_ROOTS=/srv/workspaces

# Qdrant stores rebuildable document and project-memory vectors.
# TODO(PRODUCTION): provision Qdrant persistence, authentication, TLS, snapshots,
# capacity limits and collection restore/rebuild procedures.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks
PROJECT_MEMORY_QDRANT_COLLECTION=project_memories

# Redis is only the Celery broker/result backend, never the business source of truth.
# TODO(PRODUCTION): provision authenticated/TLS Redis, noeviction capacity,
# persistence policy, monitoring and a dead-letter/retry operating procedure.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=2
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=60
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=960
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# Production memory remains off until PostgreSQL revisions are reviewed/applied.
# TODO(PRODUCTION): implement a distributed L3 repository before enabling user
# memory; the current L3 implementation is intentionally SQLite-local only.
PROJECT_MEMORY_ENABLED=false
PROJECT_MEMORY_MODE=off
USER_MEMORY_ENABLED=false
USER_MEMORY_MODE=off
USER_PROFILE_MAX_CONTEXT_CHARS=1500

# TODO(PRODUCTION): select providers/models, store API keys outside dotenv, define
# budgets/routing policy and run load, cost, redaction and failure-mode tests.
LLM_PROVIDER=fake
LLM_MODEL=demo-stream-model
LLM_MAX_OUTPUT_TOKENS=4096
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
MODEL_SECRET_BACKEND=keyring
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# TODO(PRODUCTION): replace placeholders with the real OIDC issuer/audience/JWKS,
# rotate the gateway trust secret and validate forwarded-header boundaries.
AUTH_MODE=trusted_header
NATIVE_DIRECTORY_PICKER_MODE=disabled
GATEWAY_AUTH_MODE=oidc
GATEWAY_TRUST_SECRET=replace-from-secret-manager
GATEWAY_OIDC_ISSUER=https://identity.example.com/
GATEWAY_OIDC_AUDIENCE=ai-agent-platform
GATEWAY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
GATEWAY_OIDC_JWKS_CACHE_TTL=5m
LIVE_WORKSPACE_WRITES_ENABLED=true
AGENT_WORKSPACE_DEFAULT_MODE=direct
AGENT_WORKSPACE_ALLOWED_MODES=direct
CHANGE_SET_APPLY_MODE=patch_only
CHANGE_SET_MAX_FILES=100
CHANGE_SET_MAX_PATCH_CHARS=1000000
CHANGE_SET_WORKTREE_PARENT=/srv/worktrees
CHANGE_SET_BRANCH_PREFIX=codex/

# TODO(PRODUCTION): use a hardened sandbox image/runtime and review every command.
# All sandbox construction fields are process-owned and cannot be project overrides.
SANDBOX_MODE=docker
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_COMMAND_OUTPUT_MAX_CHARS=12000
SANDBOX_WORKSPACE_PARENT=/srv/sandboxes
SANDBOX_WORKSPACE_TTL_SECONDS=86400
SANDBOX_ALLOWED_COMMANDS=alembic,cargo,git,go,mypy,node,npm,npx,poetry,pytest,python,python3,ruff,rustc,tox,uv
AGENT_APPROVAL_POLICY=on_request

# TODO(PRODUCTION): define a separate deployment/migration procedure, review pending
# Alembic revisions, and authorize them only after backup/rollback approval. The
# current ./scripts/start.sh is intentionally a thin single-node Compose wrapper.
